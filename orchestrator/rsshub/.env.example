# X / Twitter access for RSSHub.
#
# This is YOUR live session. It grants full access to your account, so no agent
# reads it, writes it, or copies it anywhere. Two values, pasted once, by you.
#
#   1. Open x.com in Chrome, logged in.
#   2. F12 → Application → Cookies → https://x.com
#   3. Copy the values of `auth_token` and `ct0`.
#   4. Save this file as `.env` (drop the .example) with them filled in.
#   5. cd 05-Orchestrator/rsshub && docker compose up -d
#
# The file is gitignored. If X ever logs you out everywhere, that revokes this too.

TWITTER_AUTH_TOKEN="PASTE_AUTH_TOKEN_HERE"
TWITTER_COOKIE="auth_token=PASTE_AUTH_TOKEN_HERE; ct0=PASTE_CT0_HERE"
